# Administrator build only. Runtime never pulls images or runs package networks.
FROM docker.io/library/debian@sha256:918311b7b6c4c6f68b232ba516584925f6c78ad82b6fd534b98979df6438e483
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip python3-pil ffmpeg yt-dlp jq ripgrep imagemagick \
    pandoc git file ca-certificates && rm -rf /var/lib/apt/lists/*
RUN mkdir -p /opt/wheels /inputs /workspace
# Reviewed wheels may be added by the administrator at build time.
USER 1000:1000
WORKDIR /workspace
